[32m+[m[32m/// The short commit `--version` reports, or empty when this tree is not[m
[32m+[m[32m/// itself a checkout.[m
[32m+[m[32m///[m
[32m+[m[32m/// A release tarball is built from an export with no `.git`, and failing[m
[32m+[m[32m/// the build over seven characters would be a poor trade -- `--version`[m
[32m+[m[32m/// simply prints the number without them.[m
[32m+[m[32m///[m
[32m+[m[32m/// The `.git` check is not redundant with asking git: `rev-parse` walks[m
[32m+[m[32m/// *up* out of the build root, so an unpacked source tarball sitting[m
[32m+[m[32m/// inside somebody else's working tree would otherwise be stamped with[m
[32m+[m[32m/// their HEAD -- a provenance string pointing at an unrelated commit,[m
[32m+[m[32m/// which is worse than none at all.[m
[32m+[m[32mfn gitCommit(b: *std.Build) []const u8 {[m
[32m+[m[32m    b.build_root.handle.access(b.graph.io, ".git", .{}) catch return "";[m
[32m+[m[32m    var code: u8 = undefined;[m
[32m+[m[32m    const out = b.runAllowFail([m
[32m+[m[32m        &.{ "git", "-C", b.pathFromRoot("."), "rev-parse", "--short=7", "HEAD" },[m
[32m+[m[32m        &code,[m
[32m+[m[32m        .ignore,[m
[32m+[m[32m    ) catch return "";[m
[32m+[m[32m    return std.mem.trim(u8, out, " \t\n\r");[m
[32m+[m[32m}[m
