[31m-        } else if (std.mem.eql(u8, arg, "--help") or std.mem.eql(u8, arg, "-h")) {[m
[31m-            std.debug.print([m
[31m-                \\terminator -- a terminal emulator[m
[31m-                \\[m
[31m-                \\  --font-size N   point size (default {d})[m
[31m-                \\  --size CxR      initial grid, e.g. 200x60 (default {d}x{d})[m
[31m-                \\  --shell PATH    shell to run (default $SHELL)[m
[31m-                \\  --frame-stats   print frame timing to stderr once a second[m
[31m-                \\  -h, --help      this message[m
[31m-                \\[m
[31m-                \\Keys:[m
