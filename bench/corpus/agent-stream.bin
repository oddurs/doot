[31m-                \\  Cmd V           paste[m
[31m-                \\  Cmd K           clear[m
[31m-                \\  Wheel           scroll history[m
[31m-                \\[m
[31m-            , .{ default_font_size, default_cols, default_rows });[m
[31m-            std.process.exit(0);[m
[31m-        }[m
[31m-    }[m
[31m-    return opts;[m
[31m-}[m
[1mdiff --git a/src/stats.zig b/src/stats.zig[m
[1mindex 5782bbe..8b6ddf7 100644[m
[1m--- a/src/stats.zig[m
[1m+++ b/src/stats.zig[m
[36m@@ -103,6 +103,16 @@[m [mpub const FrameStats = struct {[m
         if (elapsed < report_every_ns) return;[m
 [m
         const n = self.frames;[m
[32m+[m[32m        if (n == 0) {[m
[32m+[m[32m            // A window can elapse without a single frame being drawn: an[m
[32m+[m[32m            // event that wakes the loop without dirtying the screen -- a[m
[32m+[m[32m            // mouse move over an idle window -- does exactly that. There[m
[32m+[m[32m            // is nothing to average, so start a new window rather than[m
[32m+[m[32m            // dividing by it.[m
[32m+[m[32m            self.window_start = now;[m
[32m+[m[32m            self.window_bytes_start = bytes_read;[m
[32m+[m[32m            return;[m
[32m+[m[32m        }[m
         std.debug.print([m
             "frame-stats  {d:>4} fps  lock {d:>7.0}/{d:<7.0}  build {d:>6.0}/{d:<6.0}  present {d:>7.0}/{d:<7.0} us  calls {d:>5}/{d:<5}  pty {d:>7.2} MiB/s\n",[m
             .{[m
[36m@@ -171,3 +181,36 @@[m [mtest "a disabled timer records nothing" {[m
     s.record(.{ .lock = 1, .build = 1, .present = 1 });[m
     try testing.expectEqual(@as(u64, 0), s.frames);[m
 }[m
[32m+[m
[32m+[m[32mtest "a window that elapses with no frames starts a new one instead of dividing by zero" {[m
[32m+[m[32m    var s = FrameStats.init(true);[m
[32m+[m[32m    // Backdate the window so a report is due, and record nothing -- what[m
[32m+[m[32m    // the event loop does when it wakes for an event that sets neither[m
[32m+[m[32m    // `redraw` nor `term.dirty`. Every column here is a per-frame average.[m
[32m+[m[32m    s.window_start -= 2 * report_every_ns;[m
[32m+[m[32m    s.maybeReport(0);[m
[32m+[m
[32m+[m[32m    // The window moved on, and no frame was invented to fill it.[m
[32m+[m[32m    try testing.expectEqual(@as(u64, 0), s.frames);[m
[32m+[m[32m    try testing.expectEqual(@as(u64, 0), s.total_frames);[m
[32m+[m[32m    try testing.expect(nowNs() - s.window_start < report_every_ns);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mtest "a window with frames in it reports and resets" {[m
[32m+[m[32m    var s = FrameStats.init(true);[m
[32m+[m[32m    s.record(.{ .lock = 1_000, .build = 2_000, .present = 3_000, .calls = 2 });[m
[32m+[m[32m    s.record(.{ .lock = 3_000, .build = 4_000, .present = 5_000, .calls = 4 });[m
[32m+[m[32m    try testing.expectEqual(@as(u64, 2), s.frames);[m
[32m+[m[32m    try testing.expectEqual(@as(u64, 6), s.calls.sum);[m
[32m+[m
[32m+[m[32m    s.window_start -= 2 * report_every_ns;[m
[32m+[m[32m    s.maybeReport(4096);[m
[32m+[m
[32m+[m[32m    // The two frames are retired into the run total, not lost.[m
[32m+[m[32m    try testing.expectEqual(@as(u64, 2), s.total_frames);[m
[32m+[m[32m    try testing.expectEqual(@as(u64, 0), s.frames);[m
[32m+[m[32m    try testing.expectEqual(@as(u64, 0), s.calls.sum);[m
[32m+[m[32m    // The worst lock hold is a whole-run figure and outlives the window.[m
[32m+[m[32m    try testing.expectEqual(@as(u64, 3_000), s.total_lock_max);[m
[32m+[m[32m    try testing.expectEqual(@as(u64, 4096), s.window_bytes_start);[m
[32m+[m[32m}[m
