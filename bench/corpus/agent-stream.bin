[32m+[m[32m  gallery:[m
[32m+[m[32m    name: gallery[m
[32m+[m[32m    runs-on: macos-15[m
[32m+[m[32m    # Never gates a merge, for the same reason the bench does not: a visual[m
[32m+[m[32m    # diff is usually an intended change, and the reviewer is the one who[m
[32m+[m[32m    # decides. The job exists so the numbers and the renders sit next to[m
[32m+[m[32m    # the diff instead of living on one person's machine.[m
[32m+[m[32m    #[m
[32m+[m[32m    # The committed references are rendered on a maintainer's Mac. A runner[m
[32m+[m[32m    # whose system font differs by a version will show a whole-image delta[m
[32m+[m[32m    # here that is not a regression -- read the uploaded renders, not just[m
[32m+[m[32m    # the percentages.[m
[32m+[m[32m    continue-on-error: true[m
[32m+[m[32m    steps:[m
[32m+[m[32m      - uses: actions/checkout@v5[m
[32m+[m
[32m+[m[32m      - name: Install SDL3 and FreeType[m
[32m+[m[32m        run: |[m
[32m+[m[32m          brew update --quiet[m
[32m+[m[32m          brew install sdl3 freetype pkg-config[m
[32m+[m
[32m+[m[32m      - uses: mlugg/setup-zig@v2[m
[32m+[m[32m        with:[m
[32m+[m[32m          version: ${{ env.ZIG_VERSION }}[m
[32m+[m
[32m+[m[32m      - name: Render the gallery[m
[32m+[m[32m        # Headless: the build step sets SDL_VIDEODRIVER=dummy, so this[m
[32m+[m[32m        # needs no display. See src/gallery.zig.[m
[32m+[m[32m        run: |[m
[32m+[m[32m          zig build gallery 2>&1 | tee gallery.txt[m
[32m+[m[32m          {[m
[32m+[m[32m            echo "### Gallery"[m
[32m+[m[32m            echo[m
[32m+[m[32m            echo "Rendered headless on this runner and diffed against the committed"[m
[32m+[m[32m            echo "references. Indicative only -- a different system font version reads"[m
[32m+[m[32m            echo "as a whole-image delta. The renders are attached as an artifact."[m
[32m+[m[32m            echo[m
[32m+[m[32m            echo '```'[m
[32m+[m[32m            cat gallery.txt[m
[32m+[m[32m            echo '```'[m
[32m+[m[32m          } >> "$GITHUB_STEP_SUMMARY"[m
[32m+[m
[32m+[m[32m      - uses: actions/upload-artifact@v4[m
[32m+[m[32m        with:[m
[32m+[m[32m          name: gallery-renders[m
[32m+[m[32m          path: bench/gallery/current/*.png[m
[32m+[m[32m          if-no-files-found: error[m
