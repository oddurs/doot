         .target = target,[m
         .optimize = optimize,[m
         .link_libc = true,[m
     });[m
[32m+[m[32m    mod.addOptions("build_options", options);[m
 [m
     // Borrowed plumbing: SDL3 gives us a window, input and a Metal-backed[m
     // 2D renderer; FreeType rasterizes glyphs. Everything above these two[m
[36m@@ -40,6 +51,7 @@[m [mpub fn build(b: *std.Build) void {[m
         .optimize = optimize,[m
         .link_libc = true,[m
     });[m
