 pub fn build(b: *std.Build) void {[m
     const target = b.standardTargetOptions(.{});[m
     const optimize = b.standardOptimizeOption(.{});[m
 [m
[32m+[m[32m    // One source of truth for the version: `build.zig.zon`'s `.version`,[m
[32m+[m[32m    // handed to the code as a build option rather than retyped as a[m
