[32m+[m[32m    // busy child never allows -- the app would hang until killed. The[m
[32m+[m[32m    // deadline covers the rest: the child is gone but something it left[m
[32m+[m[32m    // behind still holds the pty open and is writing.[m
[32m+[m[32m    if (child_exited) {[m
[32m+[m[32m        const deadline = stats.nowNs() + 250 * std.time.ns_per_ms;[m
[32m+[m[32m        var tail: [65536]u8 = undefined;[m
[32m+[m[32m        while (stats.nowNs() < deadline and app.pty.waitReadable(20)) {[m
[32m+[m[32m            const n = app.pty.read(&tail) catch break;[m
[32m+[m[32m            if (n == 0) break;[m
[32m+[m[32m            app.parser.feed(&app.term, tail[0..n]);[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    // A `--shell` that prints and exits never reaches the one-second[m
[32m+[m[32m    // timer, so the last frame is captured on the way out instead. The[m
[32m+[m[32m    // gallery depends on this: its scenes are a few lines of printf and[m
[32m+[m[32m    // are gone in milliseconds.[m
[32m+[m[32m    if (renderer.screenshot_path != null) {[m
[32m+[m[32m        renderer.screenshot_after_ns = 0;[m
[32m+[m[32m        renderer.snapshot(&app.term) catch {};[m
[32m+[m[32m        _ = renderer.draw();[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    app.pty.shutdown();[m
 }[m
