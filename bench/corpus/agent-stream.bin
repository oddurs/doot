[1mdiff --git a/src/gallery.zig b/src/gallery.zig[m
[1mnew file mode 100644[m
[1mindex 0000000..eeebb98[m
[1m--- /dev/null[m
[1m+++ b/src/gallery.zig[m
[36m@@ -0,0 +1,223 @@[m
[32m+[m[32m//! The screenshot gallery: the arbiter for every visual change.[m
[32m+[m[32m//![m
[32m+[m[32m//! X0 of docs/roadmap/experience.md. The performance roadmap has[m
[32m+[m[32m//! `zig build bench`, and the rule there is that a claim carries a number[m
[32m+[m[32m//! or it is a guess. Nothing above the renderer has a number, so the[m
[32m+[m[32m//! experience roadmap gets pictures instead: each capture below renders one[m
[32m+[m[32m//! canonical screen through the real parser, grid and renderer, and is[m
[32m+[m[32m//! compared against a committed PNG.[m
[32m+[m[32m//![m
[32m+[m[32m//!   zig build gallery              render and report per-image deltas[m
[32m+[m[32m//!   zig build gallery -- --update  accept the current renders as expected[m
[32m+[m[32m//![m
[32m+[m[32m//! Headless, via `SDL_VIDEODRIVER=dummy` (set by the build step), so it[m
[32m+[m[32m//! runs on a CI runner with no display. `--scale` is what makes a 2x[m
[32m+[m[32m//! capture reproducible on a 1x machine: the app is told to pretend rather[m
[32m+[m[32m//! than asked what display it is on.[m
[32m+[m[32m//![m
[32m+[m[32m//! The scenes are shell scripts that print fixed bytes. Not `vim` or[m
[32m+[m[32m//! `htop`: their output varies with version, terminal size, locale and the[m
[32m+[m[32m//! files lying around, and a pixel diff cannot tell that apart from a[m
[32m+[m[32m//! regression. The bench corpora are committed files for the same reason.[m
[32m+[m
[32m+[m[32mconst std = @import("std");[m
[32m+[m[32mconst png = @import("png.zig");[m
[32m+[m
[32m+[m[32mconst Capture = struct {[m
[32m+[m[32m    name: []const u8,[m
[32m+[m[32m    scene: []const u8,[m
[32m+[m[32m    cols: u32,[m
[32m+[m[32m    rows: u32,[m
[32m+[m[32m    font_size: u32,[m
[32m+[m[32m    scale: u32,[m
[32m+[m[32m};[m
[32m+[m
[32m+[m[32m/// One row per committed PNG. Sizes are chosen so a capture is a few tens[m
[32m+[m[32m/// of kilobytes: these live in the repository forever.[m
[32m+[m[32mconst captures = [_]Capture{[m
[32m+[m[32m    // The typography page at the three sizes the sprint asks for, plus 2x.[m
[32m+[m[32m    // Baseline placement and cell rounding are what change between them.[m
[32m+[m[32m    .{ .name = "typography-14pt-1x", .scene = "typography", .cols = 74, .rows = 11, .font_size = 14, .scale = 1 },[m
[32m+[m[32m    .{ .name = "typography-14pt-2x", .scene = "typography", .cols = 74, .rows = 11, .font_size = 14, .scale = 2 },[m
[32m+[m[32m    .{ .name = "typography-10pt-1x", .scene = "typography", .cols = 74, .rows = 11, .font_size = 10, .scale = 1 },[m
[32m+[m[32m    .{ .name = "typography-20pt-1x", .scene = "typography", .cols = 74, .rows = 11, .font_size = 20, .scale = 1 },[m
[32m+[m
[32m+[m[32m    .{ .name = "attributes-14pt-1x", .scene = "attributes", .cols = 74, .rows = 5, .font_size = 14, .scale = 1 },[m
[32m+[m[32m    .{ .name = "attributes-14pt-2x", .scene = "attributes", .cols = 74, .rows = 5, .font_size = 14, .scale = 2 },[m
[32m+[m
[32m+[m[32m    .{ .name = "colors-14pt-1x", .scene = "colors", .cols = 112, .rows = 7, .font_size = 14, .scale = 1 },[m
[32m+[m[32m    .{ .name = "tui-14pt-1x", .scene = "tui", .cols = 52, .rows = 12, .font_size = 14, .scale = 1 },[m
[32m+[m
[32m+[m[32m    // The cursor gets its own scene at both scales: X0 is done when a[m
[32m+[m[32m    // one-pixel change in it shows up as a diff.[m
[32m+[m[32m    .{ .name = "cursor-14pt-1x", .scene = "cursor", .cols = 48, .rows = 4, .font_size = 14, .scale = 1 },[m
[32m+[m[32m    .{ .name = "cursor-14pt-2x", .scene = "cursor", .cols = 48, .rows = 4, .font_size = 14, .scale = 2 },[m
[32m+[m[32m};[m
[32m+[m
[32m+[m[32mconst expected_dir = "bench/gallery/expected";[m
[32m+[m[32mconst current_dir = "bench/gallery/current";[m
[32m+[m
[32m+[m[32mfn compare(a: png.Image, b: png.Image) struct { pixels: u64, worst: u8 } {[m
[32m+[m[32m    var differing: u64 = 0;[m
[32m+[m[32m    var worst: u8 = 0;[m
[32m+[m[32m    var i: usize = 0;[m
[32m+[m[32m    while (i < a.pixels.len) : (i += 4) {[m
[32m+[m[32m        var changed = false;[m
[32m+[m[32m        for (0..4) |ch| {[m
[32m+[m[32m            const d = @abs(@as(i16, a.pixels[i + ch]) - @as(i16, b.pixels[i + ch]));[m
[32m+[m[32m            if (d != 0) changed = true;[m
[32m+[m[32m            worst = @max(worst, @as(u8, @intCast(@min(d, 255))));[m
[32m+[m[32m        }[m
[32m+[m[32m        if (changed) differing += 1;[m
[32m+[m[32m    }[m
[32m+[m[32m    return .{ .pixels = differing, .worst = worst };[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mpub fn main(init: std.process.Init.Minimal) !void {[m
[32m+[m[32m    var threaded: std.Io.Threaded = .init(std.heap.page_allocator, .{});[m
[32m+[m[32m    defer threaded.deinit();[m
[32m+[m[32m    const io = threaded.io();[m
[32m+[m
[32m+[m[32m    var gpa_state: std.heap.DebugAllocator(.{}) = .init;[m
[32m+[m[32m    defer _ = gpa_state.deinit();[m
[32m+[m[32m    const gpa = gpa_state.allocator();[m
[32m+[m
[32m+[m[32m    const argv = init.args.vector;[m
[32m+[m[32m    if (argv.len < 2) {[m
[32m+[m[32m        std.debug.print("usage: gallery <path-to-terminator> [--update]\n", .{});[m
[32m+[m[32m        std.process.exit(2);[m
[32m+[m[32m    }[m
[32m+[m[32m    const terminator = std.mem.span(argv[1]);[m
[32m+[m[32m    var update = false;[m
[32m+[m[32m    for (argv[2..]) |a| {[m
[32m+[m[32m        if (std.mem.eql(u8, std.mem.span(a), "--update")) update = true;[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    // Spawning with no environment map hands the child an *empty* one, so[m
[32m+[m[32m    // an SDL_VIDEODRIVER set on this process would never reach it -- the[m
[32m+[m[32m    // gallery would quietly render through the real window server, and its[m
[32m+[m[32m    // references would be whatever display the maintainer happened to have.[m
[32m+[m[32m    // Setting it here rather than inheriting it also means `zig build[m
[32m+[m[32m    // gallery` is headless however it was invoked.[m
[32m+[m[32m    var environ = std.process.Environ.Map.init(gpa);[m
[32m+[m[32m    defer environ.deinit();[m
[32m+[m[32m    try environ.putPosixBlock(init.environ.block.view());[m
[32m+[m[32m    try environ.put("SDL_VIDEODRIVER", "dummy");[m
[32m+[m
[32m+[m[32m    const cwd = std.Io.Dir.cwd();[m
[32m+[m[32m    cwd.createDirPath(io, current_dir) catch {};[m
[32m+[m[32m    if (update) cwd.createDirPath(io, expected_dir) catch {};[m
[32m+[m
[32m+[m[32m    std.debug.print([m
[32m+[m[32m        \\gallery: {d} captures, headless[m
[32m+[m[32m        \\[m
[32m+[m[32m        \\  {s:<22} {s:>11} {s:>12} {s:>9}  {s}[m
[32m+[m[32m        \\  {s:-<22} {s:->11} {s:->12} {s:->9}  {s:-<28}[m
[32m+[m[32m        \\[m
[32m+[m[32m    , .{ captures.len, "capture", "size", "differing", "worst", "result", "", "", "", "", "" });[m
[32m+[m
[32m+[m[32m    var changed: usize = 0;[m
[32m+[m[32m    var added: usize = 0;[m
[32m+[m
[32m+[m[32m    for (captures) |cap| {[m
[32m+[m[32m        const scene_path = try std.fmt.allocPrint(gpa, "bench/gallery/{s}.sh", .{cap.scene});[m
[32m+[m[32m        defer gpa.free(scene_path);[m
[32m+[m[32m        const out_path = try std.fmt.allocPrint(gpa, "{s}/{s}.png", .{ current_dir, cap.name });[m
[32m+[m[32m        defer gpa.free(out_path);[m
[32m+[m[32m        const want_path = try std.fmt.allocPrint(gpa, "{s}/{s}.png", .{ expected_dir, cap.name });[m
[32m+[m[32m        defer gpa.free(want_path);[m
[32m+[m
[32m+[m[32m        const size = try std.fmt.allocPrint(gpa, "{d}x{d}", .{ cap.cols, cap.rows });[m
[32m+[m[32m        defer gpa.free(size);[m
[32m+[m[32m        const font_size = try std.fmt.allocPrint(gpa, "{d}", .{cap.font_size});[m
[32m+[m[32m        defer gpa.free(font_size);[m
[32m+[m[32m        const scale = try std.fmt.allocPrint(gpa, "{d}", .{cap.scale});[m
[32m+[m[32m        defer gpa.free(scale);[m
[32m+[m
[32m+[m[32m        cwd.deleteFile(io, out_path) catch {};[m
[32m+[m
[32m+[m[32m        var child = try std.process.spawn(io, .{[m
[32m+[m[32m            .argv = &.{[m
[32m+[m[32m                terminator,    "--shell", scene_path, "--size", size,[m
[32m+[m[32m                "--font-size", font_size, "--scale",  scale,    "--screenshot",[m
[32m+[m[32m                out_path,[m
[32m+[m[32m            },[m
[32m+[m[32m            .environ_map = &environ,[m
[32m+[m[32m            // The scenes print and exit; their output is the picture, not[m
[32m+[m[32m            // something anyone needs to read here.[m
[32m+[m[32m            .stdout = .ignore,[m
[32m+[m[32m            .stderr = .ignore,[m
[32m+[m[32m        });[m
[32m+[m[32m        _ = try child.wait(io);[m
[32m+[m
[32m+[m[32m        const got_bytes = cwd.readFileAlloc(io, out_path, gpa, .limited(64 << 20)) catch {[m
[32m+[m[32m            std.debug.print("  {s:<22} {s}\n", .{ cap.name, "FAILED to render" });[m
[32m+[m[32m            std.process.exit(1);[m
[32m+[m[32m        };[m
[32m+[m[32m        defer gpa.free(got_bytes);[m
[32m+[m[32m        var got = try png.decode(gpa, got_bytes);[m
[32m+[m[32m        defer got.deinit(gpa);[m
[32m+[m
[32m+[m[32m        const dims = try std.fmt.allocPrint(gpa, "{d}x{d}", .{ got.w, got.h });[m
[32m+[m[32m        defer gpa.free(dims);[m
[32m+[m
[32m+[m[32m        const want_bytes = cwd.readFileAlloc(io, want_path, gpa, .limited(64 << 20)) catch null;[m
[32m+[m[32m        if (want_bytes) |wb| {[m
[32m+[m[32m            defer gpa.free(wb);[m
[32m+[m[32m            // A reference that will not decode is a reason to report that[m
[32m+[m[32m            // capture and carry on, not to abandon the other nine.[m
[32m+[m[32m            var want = png.decode(gpa, wb) catch |err| {[m
[32m+[m[32m                changed += 1;[m
[32m+[m[32m                std.debug.print("  {s:<22} {s:>11} {s:>12} {s:>9}  reference unreadable ({t})\n", .{[m
[32m+[m[32m                    cap.name, dims, "-", "-", err,[m
[32m+[m[32m                });[m
[32m+[m[32m                if (update) try cwd.writeFile(io, .{ .sub_path = want_path, .data = got_bytes });[m
[32m+[m[32m                continue;[m
[32m+[m[32m            };[m
[32m+[m[32m            defer want.deinit(gpa);[m
[32m+[m
[32m+[m[32m            if (want.w != got.w or want.h != got.h) {[m
[32m+[m[32m                changed += 1;[m
[32m+[m[32m                std.debug.print("  {s:<22} {s:>11} {s:>12} {s:>9}  was {d}x{d}\n", .{[m
[32m+[m[32m                    cap.name, dims, "-", "-", want.w, want.h,[m
[32m+[m[32m                });[m
[32m+[m[32m            } else {[m
[32m+[m[32m                const d = compare(want, got);[m
[32m+[m[32m                const total: f64 = @floatFromInt(got.w * got.h);[m
[32m+[m[32m                if (d.pixels == 0) {[m
[32m+[m[32m                    std.debug.print("  {s:<22} {s:>11} {s:>12} {s:>9}  identical\n", .{ cap.name, dims, "0", "0" });[m
[32m+[m[32m                } else {[m
[32m+[m[32m                    changed += 1;[m
[32m+[m[32m                    std.debug.print("  {s:<22} {s:>11} {d:>12} {d:>9}  {d:.2}% of pixels\n", .{[m
[32m+[m[32m                        cap.name,                                          dims, d.pixels, d.worst,[m
[32m+[m[32m                        @as(f64, @floatFromInt(d.pixels)) / total * 100.0,[m
[32m+[m[32m                    });[m
[32m+[m[32m                }[m
[32m+[m[32m            }[m
[32m+[m[32m        } else {[m
[32m+[m[32m            added += 1;[m
[32m+[m[32m            std.debug.print("  {s:<22} {s:>11} {s:>12} {s:>9}  new\n", .{ cap.name, dims, "-", "-" });[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        if (update) try cwd.writeFile(io, .{ .sub_path = want_path, .data = got_bytes });[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    if (update) {[m
[32m+[m[32m        std.debug.print("\nwrote {d} captures to {s}\n", .{ captures.len, expected_dir });[m
[32m+[m[32m        return;[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    std.debug.print("\n", .{});[m
[32m+[m[32m    if (added > 0) std.debug.print("{d} capture(s) had no committed reference\n", .{added});[m
[32m+[m[32m    if (changed == 0 and added == 0) {[m
[32m+[m[32m        std.debug.print("every capture matches its committed reference\n", .{});[m
[32m+[m[32m    } else {[m
[32m+[m[32m        // Deliberately not an error. Like the bench, this reports rather[m
[32m+[m[32m        // than gates: a diff is usually an intended visual change, and the[m
[32m+[m[32m        // reviewer is the one who decides. Renders are in bench/gallery/current.[m
[32m+[m[32m        std.debug.print([m
[32m+[m[32m            "{d} capture(s) differ -- compare {s} against {s}\n",[m
[32m+[m[32m            .{ changed, current_dir, expected_dir },[m
[32m+[m[32m        );[m
[32m+[m[32m    }[m
[32m+[m[32m}[m
