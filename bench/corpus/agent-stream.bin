[1mdiff --git a/src/png.zig b/src/png.zig[m
[1mnew file mode 100644[m
[1mindex 0000000..e0f1476[m
[1m--- /dev/null[m
[1m+++ b/src/png.zig[m
[36m@@ -0,0 +1,290 @@[m
[32m+[m[32m//! A PNG encoder and decoder, for the screenshot gallery.[m
[32m+[m[32m//![m
[32m+[m[32m//! Deliberately narrow: 8-bit RGBA, no interlacing, one IDAT, filter type[m
[32m+[m[32m//! 0 on every row. That is the only shape this repository produces, and a[m
[32m+[m[32m//! decoder that accepts exactly what our encoder emits is a few dozen[m
[32m+[m[32m//! lines rather than a dependency.[m
[32m+[m
[32m+[m[32mconst std = @import("std");[m
[32m+[m
[32m+[m[32mpub const Image = struct {[m
[32m+[m[32m    w: u32,[m
[32m+[m[32m    h: u32,[m
[32m+[m[32m    /// RGBA8, row-major, `w * h * 4` bytes.[m
[32m+[m[32m    pixels: []u8,[m
[32m+[m
[32m+[m[32m    pub fn deinit(self: *Image, alloc: std.mem.Allocator) void {[m
[32m+[m[32m        alloc.free(self.pixels);[m
[32m+[m[32m        self.* = undefined;[m
[32m+[m[32m    }[m
[32m+[m[32m};[m
[32m+[m
[32m+[m[32mconst signature = [_]u8{ 0x89, 'P', 'N', 'G', 0x0d, 0x0a, 0x1a, 0x0a };[m
[32m+[m
[32m+[m[32mfn chunk(out: *std.ArrayList(u8), alloc: std.mem.Allocator, kind: *const [4]u8, data: []const u8) !void {[m
[32m+[m[32m    try out.appendSlice(alloc, &std.mem.toBytes(std.mem.nativeToBig(u32, @intCast(data.len))));[m
[32m+[m[32m    var crc = std.hash.Crc32.init();[m
[32m+[m[32m    crc.update(kind);[m
[32m+[m[32m    crc.update(data);[m
[32m+[m[32m    try out.appendSlice(alloc, kind);[m
[32m+[m[32m    try out.appendSlice(alloc, data);[m
[32m+[m[32m    try out.appendSlice(alloc, &std.mem.toBytes(std.mem.nativeToBig(u32, crc.final())));[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mpub fn encode(alloc: std.mem.Allocator, img: Image) ![]u8 {[m
[32m+[m[32m    var out: std.ArrayList(u8) = .empty;[m
[32m+[m[32m    errdefer out.deinit(alloc);[m
[32m+[m[32m    try out.appendSlice(alloc, &signature);[m
[32m+[m
[32m+[m[32m    var ihdr: [13]u8 = undefined;[m
[32m+[m[32m    std.mem.writeInt(u32, ihdr[0..4], img.w, .big);[m
[32m+[m[32m    std.mem.writeInt(u32, ihdr[4..8], img.h, .big);[m
[32m+[m[32m    ihdr[8] = 8; // bit depth[m
[32m+[m[32m    ihdr[9] = 6; // colour type: truecolour with alpha[m
[32m+[m[32m    ihdr[10] = 0; // deflate[m
[32m+[m[32m    ihdr[11] = 0; // adaptive filtering[m
[32m+[m[32m    ihdr[12] = 0; // no interlace[m
[32m+[m[32m    try chunk(&out, alloc, "IHDR", &ihdr);[m
[32m+[m
[32m+[m[32m    // Filter byte 0 in front of every row, then deflate the lot.[m
[32m+[m[32m    const stride = img.w * 4;[m
[32m+[m[32m    var raw = try alloc.alloc(u8, (stride + 1) * img.h);[m
[32m+[m[32m    defer alloc.free(raw);[m
[32m+[m[32m    for (0..img.h) |y| {[m
[32m+[m[32m        raw[y * (stride + 1)] = 0;[m
[32m+[m[32m        @memcpy(raw[y * (stride + 1) + 1 ..][0..stride], img.pixels[y * stride ..][0..stride]);[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    // Deflate can expand incompressible input slightly; half again plus a[m
[32m+[m[32m    // kilobyte is far more headroom than a zlib stream ever needs.[m
[32m+[m[32m    const comp_buf = try alloc.alloc(u8, raw.len + raw.len / 2 + 1024);[m
[32m+[m[32m    defer alloc.free(comp_buf);[m
[32m+[m[32m    const window = try alloc.alloc(u8, std.compress.flate.max_window_len);[m
[32m+[m[32m    defer alloc.free(window);[m
[32m+[m
[32m+[m[32m    var comp_writer = std.Io.Writer.fixed(comp_buf);[m
[32m+[m[32m    var deflate = try std.compress.flate.Compress.init(&comp_writer, window, .zlib, .default);[m
[32m+[m[32m    try deflate.writer.writeAll(raw);[m
[32m+[m[32m    try deflate.finish();[m
[32m+[m[32m    try chunk(&out, alloc, "IDAT", comp_writer.buffered());[m
[32m+[m
[32m+[m[32m    try chunk(&out, alloc, "IEND", "");[m
[32m+[m[32m    return out.toOwnedSlice(alloc);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mpub const DecodeError = error{[m
[32m+[m[32m    NotPng,[m
[32m+[m[32m    UnsupportedFormat,[m
[32m+[m[32m    Truncated,[m
[32m+[m[32m    BadChecksum,[m
[32m+[m[32m    TooLarge,[m
[32m+[m[32m    OutOfMemory,[m
[32m+[m[32m} || std.compress.flate.Decompress.Error;[m
[32m+[m
[32m+[m[32m/// Enough for any screen anyone will capture, and small enough that the[m
[32m+[m[32m/// header cannot talk the decoder into a huge allocation. `w * h * 4` for[m
[32m+[m[32m/// this many pixels is 128 MiB.[m
[32m+[m[32mpub const max_pixels: u64 = 32 << 20;[m
[32m+[m
[32m+[m[32m/// Decode what `encode` produces: 8-bit RGBA, no interlace, filter 0.[m
[32m+[m[32m/// Anything else is `UnsupportedFormat` rather than a partial result.[m
[32m+[m[32mpub fn decode(alloc: std.mem.Allocator, bytes: []const u8) !Image {[m
[32m+[m[32m    if (bytes.len < signature.len or !std.mem.eql(u8, bytes[0..signature.len], &signature)) {[m
[32m+[m[32m        return DecodeError.NotPng;[m
[32m+[m[32m    }[m
[32m+[m[32m    var pos: usize = signature.len;[m
[32m+[m[32m    var w: u32 = 0;[m
[32m+[m[32m    var h: u32 = 0;[m
[32m+[m[32m    var saw_iend = false;[m
[32m+[m[32m    var idat: std.ArrayList(u8) = .empty;[m
[32m+[m[32m    defer idat.deinit(alloc);[m
[32m+[m
[32m+[m[32m    while (pos + 12 <= bytes.len) {[m
[32m+[m[32m        const len = std.mem.readInt(u32, bytes[pos..][0..4], .big);[m
[32m+[m[32m        const kind = bytes[pos + 4 ..][0..4];[m
[32m+[m[32m        if (pos + 12 + len > bytes.len) return DecodeError.Truncated;[m
[32m+[m[32m        const data = bytes[pos + 8 ..][0..len];[m
[32m+[m
[32m+[m[32m        var crc = std.hash.Crc32.init();[m
[32m+[m[32m        crc.update(kind);[m
[32m+[m[32m        crc.update(data);[m
[32m+[m[32m        if (crc.final() != std.mem.readInt(u32, bytes[pos + 8 + len ..][0..4], .big)) {[m
[32m+[m[32m            return DecodeError.BadChecksum;[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        if (std.mem.eql(u8, kind, "IHDR")) {[m
[32m+[m[32m            if (len != 13) return DecodeError.UnsupportedFormat;[m
[32m+[m[32m            w = std.mem.readInt(u32, data[0..4], .big);[m
[32m+[m[32m            h = std.mem.readInt(u32, data[4..8], .big);[m
[32m+[m[32m            // depth 8, colour type 6, deflate, adaptive filter, no interlace[m
[32m+[m[32m            if (data[8] != 8 or data[9] != 6 or data[10] != 0 or data[11] != 0 or data[12] != 0) {[m
[32m+[m[32m                return DecodeError.UnsupportedFormat;[m
[32m+[m[32m            }[m
[32m+[m[32m        } else if (std.mem.eql(u8, kind, "IDAT")) {[m
[32m+[m[32m            try idat.appendSlice(alloc, data);[m
[32m+[m[32m        } else if (std.mem.eql(u8, kind, "IEND")) {[m
[32m+[m[32m            saw_iend = true;[m
[32m+[m[32m            break;[m
[32m+[m[32m        }[m
[32m+[m[32m        pos += 12 + len;[m
[32m+[m[32m    }[m
[32m+[m[32m    // Without IEND the file simply stopped. Decoding whatever arrived would[m
[32m+[m[32m    // hand back an image that is quietly missing its bottom rows, so a[m
[32m+[m[32m    // truncated capture has to be an error rather than a shorter picture.[m
[32m+[m[32m    if (!saw_iend) return DecodeError.Truncated;[m
[32m+[m[32m    if (w == 0 or h == 0) return DecodeError.UnsupportedFormat;[m
[32m+[m[32m    // The dimensions come straight out of the file, so they are bounded[m
[32m+[m[32m    // before they are multiplied. Without this a 70-byte header claiming[m
[32m+[m[32m    // 0x40000000 x 1 overflows the u32 arithmetic below -- a panic in a[m
[32m+[m[32m    // safe build, a bogus Image in a fast one.[m
[32m+[m[32m    if (@as(u64, w) * @as(u64, h) > max_pixels) return DecodeError.TooLarge;[m
[32m+[m
[32m+[m[32m    const stride: usize = @as(usize, w) * 4;[m
[32m+[m[32m    const raw = try alloc.alloc(u8, (stride + 1) * @as(usize, h));[m
[32m+[m[32m    defer alloc.free(raw);[m
[32m+[m
[32m+[m[32m    var reader = std.Io.Reader.fixed(idat.items);[m
[32m+[m[32m    const window = try alloc.alloc(u8, std.compress.flate.max_window_len);[m
[32m+[m[32m    defer alloc.free(window);[m
[32m+[m[32m    var out_writer = std.Io.Writer.fixed(raw);[m
[32m+[m[32m    var inflate = std.compress.flate.Decompress.init(&reader, .zlib, window);[m
[32m+[m[32m    _ = inflate.reader.streamRemaining(&out_writer) catch |err| switch (err) {[m
[32m+[m[32m        error.WriteFailed => return DecodeError.UnsupportedFormat,[m
[32m+[m[32m        else => return err,[m
[32m+[m[32m    };[m
[32m+[m[32m    if (out_writer.buffered().len != raw.len) return DecodeError.Truncated;[m
[32m+[m
[32m+[m[32m    const pixels = try alloc.alloc(u8, stride * @as(usize, h));[m
[32m+[m[32m    errdefer alloc.free(pixels);[m
[32m+[m[32m    for (0..h) |y| {[m
[32m+[m[32m        // Only filter type 0 is written by `encode`; anything else means[m
[32m+[m[32m        // this PNG came from somewhere else and is not ours to guess at.[m
[32m+[m[32m        if (raw[y * (stride + 1)] != 0) return DecodeError.UnsupportedFormat;[m
[32m+[m[32m        @memcpy(pixels[y * stride ..][0..stride], raw[y * (stride + 1) + 1 ..][0..stride]);[m
[32m+[m[32m    }[m
[32m+[m[32m    return .{ .w = w, .h = h, .pixels = pixels };[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m// ---------------------------------------------------------------------------[m
[32m+[m[32m// Tests[m
[32m+[m[32m// ---------------------------------------------------------------------------[m
[32m+[m
[32m+[m[32mconst testing = std.testing;[m
[32m+[m
[32m+[m[32mfn gradient(alloc: std.mem.Allocator, w: u32, h: u32) !Image {[m
[32m+[m[32m    const px = try alloc.alloc(u8, w * h * 4);[m
[32m+[m[32m    for (0..h) |y| for (0..w) |x| {[m
[32m+[m[32m        const i = (y * w + x) * 4;[m
[32m+[m[32m        px[i + 0] = @truncate(x *% 7);[m
[32m+[m[32m        px[i + 1] = @truncate(y *% 13);[m
[32m+[m[32m        px[i + 2] = 0x40;[m
[32m+[m[32m        px[i + 3] = 255;[m
[32m+[m[32m    };[m
[32m+[m[32m    return .{ .w = w, .h = h, .pixels = px };[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mtest "an image survives a round trip byte for byte" {[m
[32m+[m[32m    var src = try gradient(testing.allocator, 37, 11); // deliberately not round[m
[32m+[m[32m    defer src.deinit(testing.allocator);[m
[32m+[m
[32m+[m[32m    const bytes = try encode(testing.allocator, src);[m
[32m+[m[32m    defer testing.allocator.free(bytes);[m
[32m+[m[32m    var back = try decode(testing.allocator, bytes);[m
[32m+[m[32m    defer back.deinit(testing.allocator);[m
[32m+[m
[32m+[m[32m    try testing.expectEqual(src.w, back.w);[m
[32m+[m[32m    try testing.expectEqual(src.h, back.h);[m
[32m+[m[32m    try testing.expectEqualSlices(u8, src.pixels, back.pixels);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mtest "the encoding is deterministic, so an unchanged capture is an unchanged file" {[m
[32m+[m[32m    // The gallery commits these and diffs them; the same pixels have to[m
[32m+[m[32m    // produce the same bytes or every run looks like a change.[m
[32m+[m[32m    var img = try gradient(testing.allocator, 16, 16);[m
[32m+[m[32m    defer img.deinit(testing.allocator);[m
[32m+[m[32m    const a = try encode(testing.allocator, img);[m
[32m+[m[32m    defer testing.allocator.free(a);[m
[32m+[m[32m    const b = try encode(testing.allocator, img);[m
[32m+[m[32m    defer testing.allocator.free(b);[m
[32m+[m[32m    try testing.expectEqualSlices(u8, a, b);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mtest "one changed pixel changes the file" {[m
[32m+[m[32m    var img = try gradient(testing.allocator, 16, 16);[m
[32m+[m[32m    defer img.deinit(testing.allocator);[m
[32m+[m[32m    const before = try encode(testing.allocator, img);[m
[32m+[m[32m    defer testing.allocator.free(before);[m
[32m+[m
[32m+[m[32m    img.pixels[4 * 16 * 4 + 4 * 4] +%= 1; // one channel of one pixel[m
[32m+[m[32m    const after = try encode(testing.allocator, img);[m
[32m+[m[32m    defer testing.allocator.free(after);[m
[32m+[m[32m    try testing.expect(!std.mem.eql(u8, before, after));[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mtest "it writes a real PNG header and IEND" {[m
[32m+[m[32m    var img = try gradient(testing.allocator, 4, 4);[m
[32m+[m[32m    defer img.deinit(testing.allocator);[m
[32m+[m[32m    const bytes = try encode(testing.allocator, img);[m
[32m+[m[32m    defer testing.allocator.free(bytes);[m
[32m+[m
[32m+[m[32m    try testing.expectEqualSlices(u8, &signature, bytes[0..8]);[m
[32m+[m[32m    try testing.expectEqualStrings("IHDR", bytes[12..16]);[m
[32m+[m[32m    try testing.expectEqualStrings("IEND", bytes[bytes.len - 8 ..][0..4]);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mtest "corrupt input is refused rather than half-decoded" {[m
[32m+[m[32m    var img = try gradient(testing.allocator, 8, 8);[m
[32m+[m[32m    defer img.deinit(testing.allocator);[m
[32m+[m[32m    const bytes = try encode(testing.allocator, img);[m
[32m+[m[32m    defer testing.allocator.free(bytes);[m
[32m+[m
[32m+[m[32m    try testing.expectError(DecodeError.NotPng, decode(testing.allocator, "not a png at all"));[m
[32m+[m[32m    try testing.expectError(DecodeError.NotPng, decode(testing.allocator, bytes[0..4]));[m
[32m+[m
[32m+[m[32m    // A flipped bit inside IHDR has to be caught by the chunk CRC.[m
[32m+[m[32m    const torn = try testing.allocator.dupe(u8, bytes);[m
[32m+[m[32m    defer testing.allocator.free(torn);[m
[32m+[m[32m    torn[20] +%= 1;[m
[32m+[m[32m    try testing.expectError(DecodeError.BadChecksum, decode(testing.allocator, torn));[m
[32m+[m
[32m+[m[32m    const cut = try testing.allocator.dupe(u8, bytes[0 .. bytes.len - 10]);[m
[32m+[m[32m    defer testing.allocator.free(cut);[m
[32m+[m[32m    try testing.expectError(DecodeError.Truncated, decode(testing.allocator, cut));[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mtest "an oversized or overflowing header is refused, not multiplied" {[m
[32m+[m[32m    // Hand-built headers with correct CRCs, so the checksum guard does not[m
[32m+[m[32m    // catch these first. Before the bound, the first two panicked on[m
[32m+[m[32m    // integer overflow and the third asked for 13 GB.[m
[32m+[m[32m    const cases = [_][2]u32{[m
[32m+[m[32m        .{ 0x4000_0000, 1 },[m
[32m+[m[32m        .{ 1, 0x8000_0000 },[m
[32m+[m[32m        .{ 60000, 60000 },[m
[32m+[m[32m    };[m
[32m+[m[32m    for (cases) |dims| {[m
[32m+[m[32m        var buf: std.ArrayList(u8) = .empty;[m
[32m+[m[32m        defer buf.deinit(testing.allocator);[m
[32m+[m[32m        try buf.appendSlice(testing.allocator, &signature);[m
[32m+[m[32m        var ihdr: [13]u8 = undefined;[m
[32m+[m[32m        std.mem.writeInt(u32, ihdr[0..4], dims[0], .big);[m
[32m+[m[32m        std.mem.writeInt(u32, ihdr[4..8], dims[1], .big);[m
[32m+[m[32m        ihdr[8] = 8;[m
[32m+[m[32m        ihdr[9] = 6;[m
[32m+[m[32m        ihdr[10] = 0;[m
[32m+[m[32m        ihdr[11] = 0;[m
[32m+[m[32m        ihdr[12] = 0;[m
[32m+[m[32m        try chunk(&buf, testing.allocator, "IHDR", &ihdr);[m
[32m+[m[32m        try chunk(&buf, testing.allocator, "IEND", "");[m
[32m+[m[32m        try testing.expectError(DecodeError.TooLarge, decode(testing.allocator, buf.items));[m
[32m+[m[32m    }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mtest "a 1x1 image is not a special case" {[m
[32m+[m[32m    var img = try gradient(testing.allocator, 1, 1);[m
[32m+[m[32m    defer img.deinit(testing.allocator);[m
[32m+[m[32m    const bytes = try encode(testing.allocator, img);[m
[32m+[m[32m    defer testing.allocator.free(bytes);[m
[32m+[m[32m    var back = try decode(testing.allocator, bytes);[m
[32m+[m[32m    defer back.deinit(testing.allocator);[m
[32m+[m[32m    try testing.expectEqualSlices(u8, img.pixels, back.pixels);[m
[32m+[m[32m}[m
[1mdiff --git a/src/render.zig b/src/render.zig[m
[1mindex 04c3a21..dbe7e95 100644[m
[1m--- a/src/render.zig[m
[1m+++ b/src/render.zig[m
[36m@@ -20,6 +20,7 @@[m [mconst grid = @import("grid.zig");[m
 const font = @import("font.zig");[m
