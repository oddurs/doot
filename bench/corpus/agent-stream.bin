 ### V1 — The release train (one week)[m
 [m
 Releases are **sprint-driven, with a monthly floor.** A tagged release[m
[1mdiff --git a/scripts/changelog-section.sh b/scripts/changelog-section.sh[m
[1mnew file mode 100755[m
[1mindex 0000000..0ae1647[m
[1m--- /dev/null[m
[1m+++ b/scripts/changelog-section.sh[m
[36m@@ -0,0 +1,60 @@[m
[32m+[m[32m#!/bin/sh[m
[32m+[m[32m# Print CHANGELOG.md's section for a version, or fail if there isn't one.[m
[32m+[m[32m#[m
[32m+[m[32m# The release workflow uses this for both of its jobs at once: it refuses[m
[32m+[m[32m# to publish a tag the changelog says nothing about, and it uses what the[m
[32m+[m[32m# changelog does say as the release body. Notes generated from PR titles[m
[32m+[m[32m# alone are a list of commits; they go underneath, not instead.[m
[32m+[m[32m#[m
[32m+[m[32m#   scripts/changelog-section.sh 0.1.0 [CHANGELOG.md][m
[32m+[m[32m#   scripts/changelog-section.sh v0.1.0          # leading v is fine[m
[32m+[m[32m#[m
[32m+[m[32m# Exits 1 with a message on stderr when the section is missing or empty,[m
[32m+[m[32m# which is what makes it a gate rather than a formatter.[m
[32m+[m
[32m+[m[32mset -eu[m
[32m+[m
[32m+[m[32mversion=${1:?usage: changelog-section.sh VERSION [FILE]}[m
[32m+[m[32mversion=${version#v}[m
[32m+[m[32mfile=${2:-"$(dirname "$0")/../CHANGELOG.md"}[m
[32m+[m
[32m+[m[32mif [ ! -r "$file" ]; then[m
[32m+[m[32m    echo "changelog-section: cannot read $file" >&2[m
[32m+[m[32m    exit 1[m
[32m+[m[32mfi[m
[32m+[m
[32m+[m[32m# Everything between this version's heading and the next `## ` heading,[m
[32m+[m[32m# with blank lines trimmed off both ends.[m
[32m+[m[32m#[m
[32m+[m[32m# Fences are tracked because a `## ` line inside a code block is content,[m
[32m+[m[32m# not a heading -- ending the section there would publish a body cut off[m
[32m+[m[32m# mid-fence, and would do it while exiting 0. For a gate, silently wrong[m
[32m+[m[32m# content is worse than a hard failure.[m
[32m+[m[32m#[m
[32m+[m[32m# The link-reference block at the bottom of the file starts with `[`, so[m
[32m+[m[32m# it ends the section too. `\r` is tolerated so a CRLF changelog trims the[m
[32m+[m[32m# same way a LF one does.[m
[32m+[m[32msection=$([m
[32m+[m[32m    awk -v want="## [$version]" '[m
[32m+[m[32m        function blank(s) { sub(/\r$/, "", s); return s == "" }[m
[32m+[m[32m        substr($0, 1, length(want)) == want { found = 1; next }[m
[32m+[m[32m        !found { next }[m
[32m+[m[32m        /^(```|~~~)/ { lines[++n] = $0; last = n; fence = !fence; next }[m
[32m+[m[32m        !fence && /^## / { exit }[m
[32m+[m[32m        !fence && /^\[[^]]+\]:/ { exit }[m
[32m+[m[32m        { lines[++n] = $0; if (!blank($0)) last = n }[m
[32m+[m[32m        END {[m
[32m+[m[32m            first = 1[m
[32m+[m[32m            while (first <= last && blank(lines[first])) first++[m
[32m+[m[32m            for (i = first; i <= last; i++) print lines[i][m
[32m+[m[32m        }[m
[32m+[m[32m    ' "$file"[m
[32m+[m[32m)[m
[32m+[m
[32m+[m[32mif [ -z "$section" ]; then[m
[32m+[m[32m    echo "changelog-section: CHANGELOG.md has no section for $version" >&2[m
[32m+[m[32m    echo "changelog-section: add a '## [$version]' heading before tagging" >&2[m
[32m+[m[32m    exit 1[m
[32m+[m[32mfi[m
[32m+[m
[32m+[m[32mprintf '%s\n' "$section"[m
[1mdiff --git a/scripts/test-changelog-section.sh b/scripts/test-changelog-section.sh[m
[1mnew file mode 100755[m
[1mindex 0000000..ec6dbe3[m
[1m--- /dev/null[m
[1m+++ b/scripts/test-changelog-section.sh[m
[36m@@ -0,0 +1,127 @@[m
[32m+[m[32m#!/bin/sh[m
[32m+[m[32m# Tests for changelog-section.sh and zon-version.sh.[m
[32m+[m[32m#[m
[32m+[m[32m# These two scripts gate every release, and a gate that fails open is worse[m
[32m+[m[32m# than no gate -- code review of the sprint that added them found exactly[m
[32m+[m[32m# that: a `## ` line inside a fenced code block ended the section early and[m
[32m+[m[32m# still exited 0, publishing a body cut off mid-fence.[m
[32m+[m[32m#[m
[32m+[m[32m# Run directly, or via `zig build test-scripts`.[m
[32m+[m
[32m+[m[32mset -eu[m
[32m+[m
[32m+[m[32mhere=$(dirname "$0")[m
[32m+[m[32msection="$here/changelog-section.sh"[m
[32m+[m[32mzon="$here/zon-version.sh"[m
[32m+[m[32mtmp=$(mktemp -d)[m
[32m+[m[32mtrap 'rm -rf "$tmp"' EXIT[m
[32m+[m
[32m+[m[32mfails=0[m
[32m+[m[32mpass() { printf '  ok    %s\n' "$1"; }[m
[32m+[m[32mfail() { printf '  FAIL  %s\n' "$1"; fails=$((fails + 1)); }[m
[32m+[m
[32m+[m[32mcheck() { # name expected actual[m
[32m+[m[32m    if [ "$2" = "$3" ]; then pass "$1"; else[m
[32m+[m[32m        fail "$1"[m
[32m+[m[32m        printf '        want: %s\n        got:  %s\n' "$2" "$3"[m
[32m+[m[32m    fi[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mcheck_fails() { # name file version[m
[32m+[m[32m    if "$section" "$3" "$2" >/dev/null 2>&1; then[m
[32m+[m[32m        fail "$1 (exited 0; a gate must fail closed)"[m
[32m+[m[32m    else[m
[32m+[m[32m        pass "$1"[m
[32m+[m[32m    fi[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mprintf 'changelog-section.sh\n'[m
[32m+[m
[32m+[m[32mcat > "$tmp/basic.md" <<'MD'[m
[32m+[m[32m# Changelog[m
[32m+[m
[32m+[m[32m## [Unreleased][m
[32m+[m
[32m+[m[32mNothing yet.[m
[32m+[m
[32m+[m[32m## [0.2.0] — 2026-09-01[m
[32m+[m
[32m+[m[32mBody line.[m
[32m+[m
[32m+[m[32m### Added[m
[32m+[m
[32m+[m[32m- A thing.[m
[32m+[m
[32m+[m[32m## [0.1.0] — 2026-08-28[m
[32m+[m
[32m+[m[32mOlder.[m
[32m+[m
[32m+[m[32m[0.2.0]: https://example.invalid/2[m
[32m+[m[32mMD[m
[32m+[m
[32m+[m[32mcheck "extracts a section" \[m
[32m+[m[32m    "Body line.[m
[32m+[m[32m### Added[m
[32m+[m[32m- A thing." \[m
[32m+[m[32m    "$($section 0.2.0 "$tmp/basic.md" | grep -v '^$')"[m
[32m+[m
[32m+[m[32mcheck "a leading v is accepted" \[m
[32m+[m[32m    "Body line." \[m
[32m+[m[32m    "$($section v0.2.0 "$tmp/basic.md" | head -1)"[m
[32m+[m
[32m+[m[32mcheck "stops before the link-reference block" \[m
[32m+[m[32m    "Older." \[m
[32m+[m[32m    "$($section 0.1.0 "$tmp/basic.md" | grep -v '^$')"[m
[32m+[m
[32m+[m[32mcheck_fails "a missing version fails" "$tmp/basic.md" 9.9.9[m
[32m+[m[32mcheck_fails "a missing file fails" "$tmp/nope.md" 0.2.0[m
[32m+[m[32mcheck_fails "a directory instead of a file fails" "$tmp" 0.2.0[m
[32m+[m
[32m+[m[32m# A version whose section is present but empty is as bad as an absent one:[m
[32m+[m[32m# it would publish a release with no notes.[m
[32m+[m[32mprintf '# C\n\n## [0.3.0]\n\n## [0.2.0]\n\nreal\n' > "$tmp/empty.md"[m
[32m+[m[32mcheck_fails "an empty section fails" "$tmp/empty.md" 0.3.0[m
[32m+[m[32mprintf '# C\n\n## [0.3.0]\n\n\n\n## [0.2.0]\n\nreal\n' > "$tmp/blank.md"[m
[32m+[m[32mcheck_fails "a blank-only section fails" "$tmp/blank.md" 0.3.0[m
[32m+[m
[32m+[m[32m# The silent-wrong-content case: a heading inside a fence is content.[m
[32m+[m[32mprintf '# C\n\n## [0.3.0]\n\nBefore.\n\n```sh\n## not a heading\necho hi\n```\n\nAfter.\n\n## [0.2.0]\n\nold\n' > "$tmp/fence.md"[m
[32m+[m[32mcheck "a ## line inside a fence does not truncate" \[m
[32m+[m[32m    "After." \[m
[32m+[m[32m    "$($section 0.3.0 "$tmp/fence.md" | tail -1)"[m
[32m+[m[32mcheck "the fence itself is kept intact" \[m
[32m+[m[32m    "2" \[m
[32m+[m[32m    "$($section 0.3.0 "$tmp/fence.md" | grep -c '^```')"[m
[32m+[m
[32m+[m[32m# Version matching is exact, so neighbours and prefixes never collide.[m
[32m+[m[32mprintf '# C\n\n## [0.1.0-rc1]\n\nprerelease\n\n## [0.10.0]\n\nten\n\n## [0.1.0]\n\nplain\n' > "$tmp/near.md"[m
[32m+[m[32mcheck "0.1.0 does not match 0.1.0-rc1 or 0.10.0" "plain" "$($section 0.1.0 "$tmp/near.md")"[m
[32m+[m[32mcheck "0.1.0-rc1 matches only itself" "prerelease" "$($section 0.1.0-rc1 "$tmp/near.md")"[m
