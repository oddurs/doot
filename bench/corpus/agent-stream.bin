[1mdiff --git a/src/version.zig b/src/version.zig[m
[1mnew file mode 100644[m
[1mindex 0000000..cf0e6f2[m
[1m--- /dev/null[m
[1m+++ b/src/version.zig[m
[36m@@ -0,0 +1,44 @@[m
[32m+[m[32m//! The version, in one place.[m
[32m+[m[32m//![m
[32m+[m[32m//! `build.zig.zon`'s `.version` is the source of truth; `build.zig` hands[m
[32m+[m[32m//! it here as a build option along with the short commit. Nothing else in[m
[32m+[m[32m//! the tree spells the number out. `pty.zig` used to, and a constant that[m
[32m+[m[32m//! has to be kept in step with the changelog by hand is a constant that[m
[32m+[m[32m//! eventually is not -- the repository shipped a `CHANGELOG.md` entry for[m
[32m+[m[32m//! a `v0.1.0` that was never tagged.[m
[32m+[m
[32m+[m[32mconst std = @import("std");[m
[32m+[m[32mconst build_options = @import("build_options");[m
[32m+[m
[32m+[m[32m/// Sentinel-terminated because `setenv` needs a C string, and a build[m
[32m+[m[32m/// option's `[]const u8` does not carry the sentinel in its type.[m
[32m+[m[32mpub const string: [:0]const u8 = std.fmt.comptimePrint("{s}", .{build_options.version});[m
[32m+[m
[32m+[m[32m/// The short commit, or empty when this was not built from a checkout.[m
[32m+[m[32mpub const commit: [:0]const u8 = std.fmt.comptimePrint("{s}", .{build_options.commit});[m
[32m+[m
[32m+[m[32m/// What `--version` prints: `terminator 0.1.0 (faac302)`. The commit is[m
[32m+[m[32m/// what turns "it does this on my machine" into a build someone can check[m
[32m+[m[32m/// out, so it is worth the seven characters.[m
[32m+[m[32mpub const line: [:0]const u8 = if (commit.len == 0)[m
[32m+[m[32m    std.fmt.comptimePrint("terminator {s}", .{string})[m
[32m+[m[32melse[m
[32m+[m[32m    std.fmt.comptimePrint("terminator {s} ({s})", .{ string, commit });[m
[32m+[m
[32m+[m[32mconst testing = std.testing;[m
[32m+[m
[32m+[m[32mtest "the version is a semantic version and matches build.zig.zon" {[m
[32m+[m[32m    const parsed = try std.SemanticVersion.parse(string);[m
[32m+[m[32m    // Nothing here should ever be zero-length or a placeholder.[m
[32m+[m[32m    try testing.expect(parsed.major > 0 or parsed.minor > 0 or parsed.patch > 0);[m
[32m+[m[32m    try testing.expect(std.mem.startsWith(u8, line, "terminator " ++ string));[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mtest "a commit, when there is one, is a short hash" {[m
[32m+[m[32m    if (commit.len == 0) return; // built outside a checkout[m
[32m+[m[32m    // `--short=7` is a *minimum*: git lengthens the abbreviation when[m
[32m+[m[32m    // seven hex digits would be ambiguous in this repository, so asserting[m
[32m+[m[32m    // exactly seven would fail one day for a reason unrelated to any change.[m
[32m+[m[32m    try testing.expect(commit.len >= 7);[m
[32m+[m[32m    for (commit) |ch| try testing.expect(std.ascii.isHex(ch));[m
[32m+[m[32m}[m

[33mcommit faac30255ebc9dff7a494fe27670b841115f723c[m
Author: Oddur Sigurdsson <oddurs@users.noreply.github.com>
Date:   Fri Aug 28 22:42:16 2026 -0400

    fix: three defects code review found in the merged sprints (#22)
    
    All three are in the instrumentation the sprints added, not in the
    optimizations they measured -- stats.zig had two trivial unit tests and
    neither called maybeReport, so the apparatus every claim in those sprint
    records rests on was the least tested code in the repo.
    
    stats.zig: maybeReport divided the calls column by the frame count with
    no zero guard, while avgUs beside it had one. A reporting window can
    elapse with no frame drawn -- a mouse move over an idle window wakes the
    event loop without dirtying the screen -- and the next one panics,
    orphaning the child. Aborts in Debug and ReleaseSafe; on aarch64
    ReleaseFast it silently yields zero, on x86_64 it raises SIGFPE. The
    window now rolls over instead.
    
    main.zig: term.dirty was cleared before the snapshot was attempted, so
    an allocation failure in snapshot dropped the frame permanently rather
    than for one iteration -- on an idle terminal the child's last line
    would stay invisible until the user typed. Restored inside the catch,
    still under the lock.
    
    cli.zig (new): --size reached Renderer.init unchecked, where
    init_cols * cell_w + pad * 2 overflowed on the cast to i32
    (--size 4000000000x30 panicked). Option parsing moves to a module that
    imports nothing but std, because main.zig pulls in SDL and so cannot be
    in the unit-test root -- which is how an unchecked flag reached the
    renderer in the first place. Sizes clamp to 1..1000, font size to the
    6..72 range Cmd +/- already enforces, and a malformed --size is now
    declined whole rather than half-applied.
    
    Tests: 100 -> 128. The five bounds are mutation-tested and all five
    mutants are caught. The main.zig fix is verified by inspection only --
    it needs an allocation failure inside the event loop, and main.zig has
    no unit-test root to inject one from.
    
    Co-authored-by: Claude Fable 5 <noreply@anthropic.com>

