[32m+[m[32m    const options = b.addOptions();[m
[32m+[m[32m    options.addOption([]const u8, "version", zon.version);[m
[32m+[m[32m    options.addOption([]const u8, "commit", gitCommit(b));[m
[32m+[m
     const mod = b.createModule(.{[m
