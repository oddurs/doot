[32m+[m[32m#!/bin/sh[m
[32m+[m[32m# Print build.zig.zon's `.version` -- the one source of truth for the number.[m
[32m+[m[32m#[m
[32m+[m[32m# The release workflow compares this against the tag being built. Without[m
[32m+[m[32m# that check the changelog gate is satisfied by a hand-written section[m
